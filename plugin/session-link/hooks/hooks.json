{
  "description": "session-link: nudges Claude to read and post team status through the connector, and warns before editing a file a teammate is changing",
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"", "timeout": 5 }] }
    ],
    "PostToolUse": [
      { "matcher": "mcp__.*__read_feed", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/post-tool-use.sh\"", "timeout": 5 }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/pre-tool-use.sh\"", "timeout": 3 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/stop.sh\"", "timeout": 5 }] }
    ]
  }
}
